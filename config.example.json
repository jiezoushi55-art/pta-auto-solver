{
  "_说明": "复制本文件为 config.json，然后填写下面几项，其余保持默认",

  "baseUrl": "https://api.deepseek.com/v1",
  "apiKey": "在这里填你的 API Key",
  "model": "deepseek-chat",

  "pta": {
    "账号列表": [
      {
        "名字": "主号",
        "账号": "在这里填 PTA 账号（邮箱或手机号）",
        "密码": "在这里填 PTA 密码"
      }
    ],
    "当前账号": "主号",
    "自动登录": true,
    "等待滑块秒数": 90
  },

  "生成参数": {
    "temperature": 0.2,
    "maxTokens": 4096,
    "超时秒数": 180
  },

  "答题设置": {
    "语言": "python",
    "编译器": "python3",
    "自动提交": true,
    "样例不通过时最多重试次数": 2,
    "样例不通过是否仍提交": false
  },

  "浏览器": {
    "调试端口": 9222
  }
}
